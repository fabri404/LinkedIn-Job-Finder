# Django
SECRET_KEY=replace-with-a-strong-random-key

# LinkedIn credentials
LINKEDIN_USER=your-email@example.com
LINKEDIN_PASS=your-linkedin-password

# Gmail (optional — for sending CVs)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# CV path (optional)
CV_PATH=cv.pdf

# PostgreSQL (Docker default values — change for production)
DB_NAME=linkedin_job_api
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
